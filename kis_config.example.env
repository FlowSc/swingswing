# Korea Investment Open API paper trading settings.
# Copy values into your shell environment. Do not commit real keys.

KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=12345678
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_ENV=paper

# Safety switch. Keep false until you intentionally wire order execution.
KIS_ENABLE_ORDERS=false
